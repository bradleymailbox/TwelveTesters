<Window x:Class="TwelveTestersTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Twelve Testers Tray" Icon="app.ico"
        Width="1100" Height="760" MinWidth="780" MinHeight="560"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" Text="TWELVE TESTERS" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource OrangeBrush}" Margin="8,12,0,30" />
                <StackPanel>
                    <Button Content="Today" Tag="Today" Click="Navigate_Click" />
                    <Button Content="Testing" Tag="Testing" Click="Navigate_Click" />
                    <Button Content="Report" Tag="Report" Click="Navigate_Click" />
                    <Button Content="Check-in" Tag="Checkin" Click="Navigate_Click" />
                    <Button Content="Account" Tag="Account" Click="Navigate_Click" />
                    <Button Content="Settings" Tag="Settings" Click="Navigate_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,20,28,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18">
                <Button x:Name="RefreshButton" Content="Check now" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="CheckNow_Click" Padding="14,7" />
                <StackPanel>
                    <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusLine" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left"><TextBlock x:Name="LoginChip" /></Border>
                    <TextBlock x:Name="PhoneLine" Foreground="{DynamicResource SoftBrush}" TextWrapping="Wrap" />
                    <StackPanel x:Name="NoticePanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
                        <WrapPanel>
                            <Button x:Name="ConfirmExitButton" Content="Exit anyway" Click="ConfirmExit_Click" Visibility="Collapsed" />
                            <Button Content="Dismiss" Click="DismissNotice_Click" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <ContentControl x:Name="PageHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
