<Window x:Class="TwelveTestersTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Twelve Testers Test Management" Icon="app.ico"
        Width="1280" Height="820" MinWidth="1180" MinHeight="600"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- App Deployer's tab look, slightly tighter so all six pages fit the header -->
        <Style x:Key="PageTab" TargetType="RadioButton" BasedOn="{StaticResource TabSegment}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Window.Resources>
    <Grid Margin="18,14,18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header (same layout as App Deployer) ================= -->
        <DockPanel Margin="2,0,2,14">
            <Border DockPanel.Dock="Left" Background="#0E1118" CornerRadius="10" Padding="4" VerticalAlignment="Center" ToolTip="bDevStudios">
                <Image Source="pack://application:,,,/Assets/bdevstudios-logo.png" Height="40"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="LoginChip" FontWeight="SemiBold" />
                </Border>
                <Button x:Name="RefreshButton" Style="{StaticResource PrimaryButton}"
                        FontSize="16" Padding="16,7" Click="CheckNow_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RefreshIcon" Text="↻" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" />
                        <TextBlock x:Name="RefreshLabel" Text="Check now" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Style="{StaticResource Display}" FontSize="22" Text="Twelve Testers Test Management" />
                <TextBlock x:Name="StatusLine" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
            <!-- Page tabs -->
            <Border Background="{DynamicResource BgAltBrush}" CornerRadius="11" Padding="3" Margin="24,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Tab_Today" Style="{StaticResource PageTab}" GroupName="Page" Content="Today" Tag="Today" Checked="Tab_Checked" />
                    <RadioButton x:Name="Tab_Testing" Style="{StaticResource PageTab}" GroupName="Page" Content="Testing" Tag="Testing" Checked="Tab_Checked" />
                    <RadioButton x:Name="Tab_Report" Style="{StaticResource PageTab}" GroupName="Page" Content="Report" Tag="Report" Checked="Tab_Checked" />
                    <RadioButton x:Name="Tab_Checkin" Style="{StaticResource PageTab}" GroupName="Page" Content="Check-in" Tag="Checkin" Checked="Tab_Checked" />
                    <RadioButton x:Name="Tab_Account" Style="{StaticResource PageTab}" GroupName="Page" Content="Account" Tag="Account" Checked="Tab_Checked" />
                    <RadioButton x:Name="Tab_Settings" Style="{StaticResource PageTab}" GroupName="Page" Content="Settings" Tag="Settings" Checked="Tab_Checked" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- ================= Page ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16,12,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,8,10">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource Display}" FontSize="22" />
                    <StackPanel x:Name="NoticePanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="NoticeActionButton" Visibility="Collapsed" Margin="0,0,8,0" Click="NoticeAction_Click" />
                            <Button x:Name="ConfirmExitButton" Content="Exit anyway" Click="ConfirmExit_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                            <Button Content="Close" Click="DismissNotice_Click" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
                <ContentControl x:Name="PageHost" Grid.Row="1" />
            </Grid>
        </Border>

        <!-- ================= Footer ================= -->
        <TextBlock x:Name="PhoneLine" Grid.Row="2" Style="{StaticResource Muted}" Margin="4,8,0,0" />
    </Grid>
</Window>
