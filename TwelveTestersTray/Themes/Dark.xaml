<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- bDev Neon, dark (matches assets/site.css on the website). Light.xaml must define the same keys. -->
    <Color x:Key="BgColor">#0E0F15</Color>
    <Color x:Key="BgMidColor">#171A26</Color>
    <Color x:Key="BgTopColor">#232B44</Color>
    <Color x:Key="PanelColor">#1E2130</Color>
    <Color x:Key="PanelHiColor">#252A3C</Color>
    <Color x:Key="StrokeColor">#2E3348</Color>
    <Color x:Key="CyanColor">#2EE6F0</Color>
    <Color x:Key="OrangeColor">#FF8A1F</Color>
    <Color x:Key="OrangeDeepColor">#FF6A00</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#0E0F15" />
    <SolidColorBrush x:Key="BgAltBrush" Color="#12141D" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1E2130" />
    <SolidColorBrush x:Key="PanelHiBrush" Color="#252A3C" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#2E3348" />
    <SolidColorBrush x:Key="TextBrush" Color="#F4F6FB" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8B93A7" />
    <SolidColorBrush x:Key="SoftBrush" Color="#B8BFCF" />
    <SolidColorBrush x:Key="CyanBrush" Color="#2EE6F0" />
    <SolidColorBrush x:Key="CyanFaintBrush" Color="#1F2EE6F0" />
    <SolidColorBrush x:Key="OrangeBrush" Color="#FF8A1F" />
    <SolidColorBrush x:Key="OrangeFaintBrush" Color="#26FF8A1F" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="TickBrush" Color="#0E0F15" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#3A4058" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#55607F" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#1A0E00" />

    <RadialGradientBrush x:Key="WindowBackground" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.75">
        <GradientStop Color="#232B44" Offset="0" />
        <GradientStop Color="#171A26" Offset="0.55" />
        <GradientStop Color="#0E0F15" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA24A" Offset="0" />
        <GradientStop Color="#FF6A00" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
