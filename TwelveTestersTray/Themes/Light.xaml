<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- bDev Neon, light. Same keys as Dark.xaml; accents are darkened so text on white stays readable. -->
    <Color x:Key="BgColor">#EEF1F7</Color>
    <Color x:Key="BgMidColor">#F3F5FA</Color>
    <Color x:Key="BgTopColor">#DDE6F7</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="PanelHiColor">#EEF1F7</Color>
    <Color x:Key="StrokeColor">#D5DAE5</Color>
    <Color x:Key="CyanColor">#0A8F9A</Color>
    <Color x:Key="OrangeColor">#D96A00</Color>
    <Color x:Key="OrangeDeepColor">#FF6A00</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#EEF1F7" />
    <SolidColorBrush x:Key="BgAltBrush" Color="#F7F8FB" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelHiBrush" Color="#EEF1F7" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#D5DAE5" />
    <SolidColorBrush x:Key="TextBrush" Color="#141826" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5F6880" />
    <SolidColorBrush x:Key="SoftBrush" Color="#3C4459" />
    <SolidColorBrush x:Key="CyanBrush" Color="#0A8F9A" />
    <SolidColorBrush x:Key="CyanFaintBrush" Color="#1A0A8F9A" />
    <SolidColorBrush x:Key="OrangeBrush" Color="#D96A00" />
    <SolidColorBrush x:Key="OrangeFaintBrush" Color="#1FD96A00" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="TickBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#C3C9D6" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#9AA3B5" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#1A0E00" />

    <RadialGradientBrush x:Key="WindowBackground" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.75">
        <GradientStop Color="#DDE6F7" Offset="0" />
        <GradientStop Color="#F3F5FA" Offset="0.55" />
        <GradientStop Color="#EEF1F7" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA24A" Offset="0" />
        <GradientStop Color="#FF6A00" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
